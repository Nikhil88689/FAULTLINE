# Optional for demo mode. Use the provider's pooled PostgreSQL URL at runtime.
DATABASE_URL=
# Required only when running Prisma Migrate from a trusted environment.
DIRECT_URL=

# Optional. Leave unset to use the deterministic, local evidence-only fallback.
# Keep this server-side; never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
# Optional Responses API model override.
FAULTLINE_AI_MODEL="gpt-5.4-mini"
